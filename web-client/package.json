{
  "name": "stitch-web-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --project-path ../stitch-server/crates/game_server",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "perf:probe": "bun run scripts/render_perf_probe.ts",
    "visual:capture": "bash scripts/visual_regression_capture.sh",
    "visual:compare": "bash scripts/visual_regression_compare.sh"
  },
  "dependencies": {
    "koota": "^0.6.5",
    "spacetimedb": "^1.4.0",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
