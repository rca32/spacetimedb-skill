{
  "name": "stitch-babylon-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "assets:sync": "node ./scripts/sync-assets.mjs --bundle=core",
    "spacetime:clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('src/module_bindings', { recursive: true, force: true });\"",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --bin-path ../stitch-server/target/wasm32-unknown-unknown/release/game_server.wasm",
    "spacetime:generate:from-source": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../stitch-server/crates/game_server",
    "spacetime:regenerate": "bun run spacetime:clean && bun run spacetime:generate"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/gui": "^7.0.0",
    "@babylonjs/havok": "^1.0.0",
    "@babylonjs/inspector": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0",
    "@babylonjs/materials": "^7.0.0",
    "spacetimedb": "2.0.3"
  },
  "devDependencies": {
    "bun-types": "1.3.10",
    "playwright": "^1.58.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
