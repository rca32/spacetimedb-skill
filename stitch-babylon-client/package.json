{
  "name": "stitch-babylon-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:sync": "node ./scripts/sync-assets.mjs --bundle=core",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --project-path ../stitch-server/crates/game_server"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/gui": "^7.0.0",
    "@babylonjs/havok": "^1.0.0",
    "@babylonjs/inspector": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0",
    "@babylonjs/materials": "^7.0.0",
    "spacetimedb": "1.11.3"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
