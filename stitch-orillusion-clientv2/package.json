{
  "name": "stitch-orillusion-clientv2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "assets:copy": "node scripts/copy-kenney-assets.mjs sync --profile core-only",
    "asset-copy": "node scripts/copy-kenney-assets.mjs",
    "codegen": "bash scripts/codegen-spacetimedb.sh",
    "codegen:private": "bash scripts/codegen-spacetimedb.sh --include-private",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:lane-a": "node scripts/run-suite-lane-a.mjs",
    "test:lane-a-core": "node scripts/run-suite-lane-a.mjs --suite core",
    "risk:check": "node scripts/risk-registry.mjs check",
    "risk:snapshot": "node scripts/risk-registry.mjs snapshot",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "spacetimedb": "file:../SpacetimeDB/crates/bindings-typescript"
  },
  "devDependencies": {
    "playwright": "1.53.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
